# Copy to .env for local development. Real values live in the platform secret manager.
DATABASE_URL=postgresql://elha2:elha2@localhost:5432/elha2
TEST_DATABASE_URL=postgresql://elha2:elha2@localhost:5432/elha2_test

# Auth: set SUPABASE_URL to verify Supabase tokens through the project's JWKS.
# Without it, tokens are checked with AUTH_JWT_SECRET (local development and tests).
SUPABASE_URL=
AUTH_JWT_SECRET=

# AI gateway (US-14.01). Free tiers for the course: Gemini main, Groq backup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDERS=gemini,groq
AI_TIMEOUT_MS=15000
AI_DAILY_RECEIPTS_PER_USER=30
