# Copy to .env for local development. Real values live in the platform secret manager.
DATABASE_URL=postgresql://elha2:elha2@localhost:5432/elha2
TEST_DATABASE_URL=postgresql://elha2:elha2@localhost:5432/elha2_test

# Auth: set SUPABASE_URL to verify Supabase tokens through the project's JWKS.
# Without it, tokens are checked with AUTH_JWT_SECRET (local development and tests).
SUPABASE_URL=
AUTH_JWT_SECRET=

# AI gateway (US-14.01). Free tiers for the course: Gemini main, Groq backup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Reads receipt photos when Gemini cannot; empty = Gemini only.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
AI_PROVIDERS=gemini,groq
AI_TIMEOUT_MS=15000
AI_DAILY_RECEIPTS_PER_USER=30
AI_DAILY_CHAT_PER_USER=40

# Push notifications (US-11.01). Download the key from Firebase → Project settings →
# Service accounts → Generate new private key, save it next to this file. Never commit it.
# Without it, notifications are stored and listed but not pushed.
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json
# Where a tapped web notification opens (optional), e.g. https://elha2.web.app
APP_WEB_URL=

# Barcode lookup (US-2.03): the open product database (free, no key).
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
