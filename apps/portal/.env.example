# Copy to .env.local (git-ignored). Leave both empty to run the demo with mock sign-in.
# The publishable key is in Supabase → Project Settings → API Keys (it is meant for browsers).
VITE_SUPABASE_URL=https://ujvucfvrhlrjttzmavgg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# The NestJS backend (apps/api). Leave empty to use demo data. Product review (admin) uses it so far.
VITE_API_URL=
# Only without Supabase sign-in: a local admin token from `pnpm -s dev-token --admin` in apps/api.
VITE_API_DEV_TOKEN=
